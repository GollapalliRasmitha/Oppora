# Copy to .env and fill in. Never commit real values.

# --- Postgres / Redis (docker-compose) ---
POSTGRES_DB=oppora
POSTGRES_USER=oppora
POSTGRES_PASSWORD=oppora
DATABASE_URL=postgres://oppora:oppora@localhost:5432/oppora
REDIS_URL=redis://localhost:6379/0

# --- Django (Stage 7+) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The browser's origin (Next.js). Trusted for CSRF; /api is proxied from here.
FRONTEND_ORIGIN=http://localhost:3000
# Zone used for "today" when the browser doesn't send one.
DEFAULT_USER_TIMEZONE=Asia/Kolkata
# Stage 7 only: lets the local app sign in as the seeded demo user (needs DJANGO_DEBUG=true).
DJANGO_DEV_LOGIN=true
DEMO_USER_EMAIL=rasmitha@example.com

# --- Google OAuth + Gmail (Stage 8) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
GMAIL_INITIAL_SYNC_DAYS=60

# --- OpenAI (Stage 8) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Security (Stage 10) ---
# Key used to encrypt OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- Frontend (read by next.config.ts on the server; never exposed to the browser) ---
# Django origin that Next.js proxies /api/* to.
BACKEND_ORIGIN=http://localhost:8000
