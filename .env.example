# Copy to .env and fill in. Never commit real values.

# --- Postgres / Redis (docker-compose) ---
POSTGRES_DB=oppora
POSTGRES_USER=oppora
POSTGRES_PASSWORD=oppora
DATABASE_URL=postgres://oppora:oppora@localhost:5432/oppora
REDIS_URL=redis://localhost:6379/0
# celery (default): syncs run in the Celery worker. thread: in the web process (no worker needed).
JOBS_BACKEND=celery

# --- Django (Stage 7+) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The browser's origin (Next.js). Trusted for CSRF; /api is proxied from here.
FRONTEND_ORIGIN=http://localhost:3000
# Zone used for "today" when the browser doesn't send one.
DEFAULT_USER_TIMEZONE=Asia/Kolkata
# Without Google credentials, "Sign in with Google" signs in the seeded demo user instead
# (local development only: needs DJANGO_DEBUG=true; switched off automatically once GOOGLE_* is set).
DJANGO_DEV_LOGIN=true
DEMO_USER_EMAIL=alex@example.com

# --- Google sign-in + Gmail (Stage 8) — see docs/google-cloud-setup.md ---
# OAuth client of type "Web application". Keep the app in Testing mode with your Gmail as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the "Authorized redirect URI" in Google Cloud exactly (through the Next.js origin).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# First scan looks back this many days; later scans only fetch new mail.
GMAIL_INITIAL_SYNC_DAYS=60
GMAIL_MAX_MESSAGES_PER_SYNC=500

# --- AI pipeline (Stage 8) ---
# gemini (free tier, default) or openai (paid). Only one interface; switch here.
AI_PROVIDER=gemini
# From https://aistudio.google.com/apikey — use a project WITHOUT billing so it stays free.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically while the main model reports overload (503 "high demand"). Also free tier.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Paid — only if you switch AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
# Free-tier limits: check yours at https://aistudio.google.com/rate-limit and set these at or below them.
# The sync waits and retries instead of failing; over the daily limit, emails stay queued for the next day.
AI_REQUESTS_PER_MINUTE=9
AI_REQUESTS_PER_DAY=200
# Characters of cleaned email text sent to the AI (subject + sender + trimmed body; never attachments).
AI_MAX_BODY_CHARS=4000

# --- Rate limits (requests per period; defaults shown) ---
RATE_ANON=60/min
RATE_USER=600/min
RATE_AUTH=20/min
RATE_SYNC=20/hour
RATE_ASSISTANT=20/min
# Proxies in front of Django that add X-Forwarded-For, for requests that don't come through the website
# (local: the Next.js dev server = 1; Render: 3). See backend/core/client_ip.py.
NUM_PROXIES=1
# Same value in Render (oppora-api) and Vercel: proves the website's visitor-IP header. Empty locally.
PROXY_SECRET=

# --- Production only (DJANGO_DEBUG=false behind HTTPS) ---
# HSTS is on automatically when DEBUG is off; preload is a long-term commitment for a real domain.
SECURE_HSTS_PRELOAD=false
SECURE_SSL_REDIRECT=true
# Set to true only when a proxy you control terminates TLS and sets X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=false

# --- Security ---
# Fernet key that encrypts OAuth tokens at rest. start-oppora.ps1 generates one; or run:
#   backend\.venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Rotate: TOKEN_ENCRYPTION_KEY=<new>,<old>, run `manage.py rotate_token_key`, then remove <old>.

# --- Frontend (read by next.config.ts on the server; never exposed to the browser) ---
# Django origin that Next.js proxies /api/* to.
BACKEND_ORIGIN=http://localhost:8000

# --- Free deployment (Vercel + Render + Neon + Upstash) — see docs/deploy.md ---
# Locally these can stay as they are. In production they're set in Render's dashboard.
# Public "Try the demo" button (shared sample account). Read-only defaults to on when DEBUG is off.
PUBLIC_DEMO_ENABLED=true
# DEMO_READ_ONLY=true
# Split the daily AI budget equally between connected accounts.
AI_FAIR_SHARE=true
# Time box for one scan in seconds (0 = until done). Render free: 480; progress is saved per email.
SYNC_BATCH_SECONDS=0
# Scheduler endpoint POST /api/cron/ (GitHub Actions, hourly). Empty = off. >= 32 characters.
# Generate production secrets with: python backend/manage.py generate_secrets
CRON_SECRET=
CRON_BATCH_SECONDS=600

# --- GuardRail (security monitoring; backend/guardrail/client.py). Off unless all three are set. ---
# Locally: true, http://localhost:3100, and the SAME value as INGEST_SECRET_OPPORA in guardrail/.env
# (guardrail's `npm run connect:oppora` writes these for you, without showing the secret).
GUARDRAIL_ENABLED=
GUARDRAIL_URL=
GUARDRAIL_SECRET=
# Rarely needed: more origins trusted for CSRF (comma-separated).
# CSRF_EXTRA_ORIGINS=
# LOG_LEVEL=INFO
# Only for `manage.py copy_account` (local → Neon): set it in the terminal for one command, never here.
# TARGET_DATABASE_URL=
